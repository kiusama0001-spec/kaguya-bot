# Configuración local de Kaguya
# Completa únicamente las credenciales que vayas a utilizar.
# No pongas claves reales en este archivo.

NODE_ENV=development
PORT=10000
BASE_PATH=/

# Telegram
TELEGRAM_BOT_TOKEN=

# PostgreSQL
DATABASE_URL=

# IA
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_VISION_MODEL=qwen/qwen3.8-27b
KAGUYA_GROQ_CHAT_RPM=12

# Búsquedas web
BRAVE_SEARCH_API_KEY=
KAGUYA_WIKI_SEARCH_RPM=10

# Voz opcional
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_ALLOW_GROUP_TTS=false

# Autenticación opcional
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Administradores
KAGUYA_ADMIN_EMAILS=
KAGUYA_ADMIN_CLERK_USER_IDS=
KAGUYA_KIU_TELEGRAM_IDS=
KAGUYA_KIU_USERNAME=
KAGUYA_LONELY_AFTER_HOURS=12
KAGUYA_KALU_TELEGRAM_IDS=
